# build output
local-tools/bin/
local-tools/obj/

# the kit's own RAG index (regenerable)
docs/.index/

# dropped reference projects / scratch (not kit source)
_tempReference/

# examples/cms3 ships a BUILD ARTIFACT (dotnet publish output) from a separate, private project - see its
# README. The compiled output is regenerated, not authored here, so it stays OUT of git history: committing
# ~57MB of DLLs would bloat history permanently and every republish would add another full copy (hard to
# undo later; staying gitignored is trivially reversible the other way). package-kit.ps1 still ships it
# correctly - it copies from the live filesystem, not from git. Only the README (real, authored content)
# is tracked.
examples/cms3/*
!examples/cms3/README.md

# session + tooling state
.claude/
__pycache__/
*.pyc

# secrets must never be committed (scan-secrets.ps1 + the pre-commit hook enforce this)
.env
.env.*
!.env.example
*.pem
*.pfx
*.key
secrets/
appsettings.*.local.json
*.binlog
_tmp/
nul
NUL
bin/
obj/
docs/.index/
